# Dockerfile for CogniMail ML Retraining Worker
# Production-ready container for continuous learning and model updates

FROM python:3.11-slim

LABEL maintainer="CogniMail Team"
LABEL description="ML Retraining Worker for continuous learning from feedback"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY classifier/ ./classifier/
COPY database/ ./database/
COPY worker/ ./worker/
COPY dashboard/database.py ./dashboard/database.py
COPY dashboard/auth.py ./dashboard/auth.py
COPY dashboard/config.py ./dashboard/config.py

# Create directories for models and backups
RUN mkdir -p classifier/models/backups

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import os; from pathlib import Path; exit(0 if Path('classifier/models/xgb_model_latest.joblib').exists() else 1)"

# Run retraining worker in continuous mode
CMD ["python", "-m", "worker.ml_retraining_worker"]
